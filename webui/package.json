{
  "name": "ani-rss-webui",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:all": "node --experimental-strip-types tools/build-all.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:themes": "node --experimental-strip-types shared/themes/apply.test.ts",
    "test:api": "node --experimental-strip-types shared/http.test.ts",
    "test": "npm run test:themes && npm run test:api"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "js-md5": "^0.8.3",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "sass-embedded": "^1.80.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue-tsc": "^3.3.10"
  }
}
