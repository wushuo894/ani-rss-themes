{
  "name": "ani-rss-themes",
  "private": true,
  "type": "module",
  "description": "仓库分两半：legacy/ 是给 ani-rss 自带界面换肤的 CSS+JS，webui/ 是替代整个界面的 Vue 应用。这里只放几个转手的脚本，依赖装在 webui/。",
  "scripts": {
    "dev": "npm --prefix webui run dev",
    "build": "npm --prefix webui run build:all",
    "build:demo": "npm --prefix webui run build:all -- --demo",
    "test:themes": "npm --prefix webui run test:themes"
  }
}
